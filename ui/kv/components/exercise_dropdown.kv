<ExerciseDropdown>:
    id: exercise_menu_button	
    text: app.selected_exercise if app.selected_exercise else "Ajoute un exercice"
    text_color:"white"
    font_size:root.font_size_button
    icon:"menu-swap"
    icon_color:"white"
    line_color:"red"
    line_width:1.5
    pos_hint:{"center_x": 0.5, "center_y": 0.5}
    size_hint:(1, None)